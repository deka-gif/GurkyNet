APP_NAME=GurkyNet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.gurkynet.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gurkynet
DB_USERNAME=gurkynet
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=gurkynet_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="GurkyNet"
RESEND_API_KEY=

# Sanctum / CORS (comma-separated origins)
SANCTUM_STATEFUL_DOMAINS=gurkynet.id,www.gurkynet.id,app.gurkynet.id
CORS_ALLOWED_ORIGINS=https://gurkynet.id,https://www.gurkynet.id,https://app.gurkynet.id
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_MAX_AGE=600

# Observability — required in production for /status and /metrics
HEALTH_METRICS_TOKEN=

# Media / CDN (optional)
CDN_URL=
# When CDN_URL is empty, media is streamed via this Laravel API path
# (SPA hosts often return index.html for classic /storage/* URLs).
MEDIA_DELIVERY_PATH=/api/v1/public/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_BASE_URL=
PAYMENT_GATEWAY=midtrans

# Digiflazz
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_SECRET=
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_PRODUCT_PROVIDER_NAME=Digiflazz

# Automatic catalog sync (Laravel Scheduler — Sprint 6.3)
# Cron on VPS: * * * * * php artisan schedule:run
PPOB_CATALOG_AUTO_SYNC_ENABLED=true
PPOB_CATALOG_AUTO_SYNC_AT=23:59
PPOB_CATALOG_AUTO_SYNC_TIMEZONE=Asia/Jakarta
PPOB_DIGIFLAZZ_SYNC_COOLDOWN_MINUTES=5
PPOB_CATALOG_SYNC_RETRY_DELAY_SECONDS=120
PPOB_CATALOG_SYNC_MAX_RETRIES=2

# Homepage Builder — set Settings key homepage_builder_marketing_can_publish=false
# to restrict Marketing role to draft-only (Manager/Owner still publish via Owner role).
# Optional Topup request fields (omit / leave empty to keep legacy payload):
# DIGIFLAZZ_TESTING=true
# DIGIFLAZZ_MAX_PRICE=
# DIGIFLAZZ_CB_URL=
# DIGIFLAZZ_ALLOW_DOT=true

# VIP Reseller / VIPAYMENT (official: API ID + API Key; sign = md5(API ID + API Key))
# Production canonical credentials:
VIP_MERCHANT_ID=          # API ID from VIP dashboard
VIP_API_KEY=              # API Key from VIP dashboard
VIP_SIGNATURE=            # optional; if empty, computed as md5(VIP_MERCHANT_ID + VIP_API_KEY)
# Optional:
VIP_BASE_URL=https://vip-reseller.co.id/api
VIP_PRODUCT_PROVIDER_NAME=VIPAYMENT
VIP_PRODUCT_PROVIDER_ENABLED=true
# Deprecated alias for VIP_MERCHANT_ID (not required):
# VIP_USERNAME=

# Firebase Cloud Messaging — External Dependency for push delivery
FCM_SERVER_KEY=
FCM_SENDER_ID=
