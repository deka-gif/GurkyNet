{
  "expo": {
    "name": "GurkyPay",
    "owner": "dechaprios-team",
    "slug": "gurkypay",
    "scheme": "gurkypay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gurkynet.gurkypay",
      "infoPlist": {
        "NSFaceIDUsageDescription": "GurkyPay menggunakan Face ID untuk membuka aplikasi dengan aman di perangkat ini.",
        "NSBluetoothAlwaysUsageDescription": "GurkyPay membutuhkan Bluetooth untuk menghubungkan printer thermal dan mencetak struk transaksi.",
        "NSBluetoothPeripheralUsageDescription": "GurkyPay membutuhkan Bluetooth untuk menghubungkan printer thermal dan mencetak struk transaksi.",
        "NSLocalNetworkUsageDescription": "GurkyPay membutuhkan akses jaringan lokal untuk mencetak ke printer thermal melalui Wi‑Fi/TCP jika tersedia."
      }
    },
    "android": {
      "package": "com.gurkynet.gurkypay",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F6A4D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F6A4D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "GurkyPay membutuhkan akses galeri untuk mengganti foto profil.",
          "cameraPermission": "GurkyPay membutuhkan akses kamera hanya saat kamu memilih ambil foto profil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GurkyPay membutuhkan akses kamera untuk memindai barcode atau QR nomor seri voucher fisik.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-audio",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F6A4D",
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-thermal-printer-driver",
        {
          "bluetoothAlwaysUsageDescription": "GurkyPay membutuhkan Bluetooth untuk menghubungkan printer thermal dan mencetak struk transaksi.",
          "bluetoothPeripheralUsageDescription": "GurkyPay membutuhkan Bluetooth untuk menghubungkan printer thermal dan mencetak struk transaksi."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e8504cf-f138-41aa-934d-44a5ee36c5c3"
      }
    }
  }
}
