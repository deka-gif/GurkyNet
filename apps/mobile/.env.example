# Same API the web dashboard uses — never point this at a mobile-only backend (spec section 1).
#
# - Android emulator talking to a Laravel dev server on the host machine: http://10.0.2.2:9000/api/v1
# - iOS simulator / same-machine dev server:                              http://127.0.0.1:9000/api/v1
# - Physical device on the same Wi-Fi as your dev machine:                http://<your-lan-ip>:9000/api/v1
# - Staging/production:                                                    https://api.gurkynet.my.id/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:9000/api/v1
